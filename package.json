{
  "name": "effective-bassoon",
  "type": "module",
  "scripts": {
    "state:dev": "npx sst state export | jq '.latest.resources[0].outputs'",
    "state:production": "npx sst state export --stage production | jq '.latest.resources[0].outputs'",
    "sso": "aws sso login --sso-session=Developer",
    "dev": "npx sst dev",
    "sst:deploy": "npx sst deploy",
    "secret": "npx sst secret set",
    "secret:list": "npx sst secret list",
    "build": "esbuild --bundle --outfile=./dist/index.js --platform=node --target=node20 ./src/index.ts",
    "deploy": "run-s build zip update",
    "update": "aws lambda update-function-code --zip-file fileb://lambda.zip --function-name hello",
    "zip": "zip -j lambda.zip dist/index.js",
    "web:build": "vite build",
    "web:dev": "vite dev",
    "web:preview": "vite preview",
    "postinstall": "patch-package",
    "patch": "patch-package"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.148",
    "@types/facebook-nodejs-business-sdk": "^20.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "esbuild": "^0.21.4",
    "glob": "^11.0.1",
    "npm-run-all2": "^6.2.0",
    "patch-package": "^8.0.0",
    "valibot": "^1.0.0",
    "vite": "^6.2.5"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.782.0",
    "@aws-sdk/client-dynamodb": "^3.782.0",
    "@aws-sdk/client-s3": "^3.782.0",
    "@aws-sdk/lib-dynamodb": "^3.782.0",
    "@aws-sdk/s3-request-presigner": "^3.782.0",
    "@openauthjs/openauth": "^0.4.3",
    "facebook-nodejs-business-sdk": "^22.0.1",
    "hono": "^4.7.5",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "sst": "3.12.3",
    "stripe": "^18.0.0",
    "vite-plugin-mkcert": "^1.17.8"
  }
}
